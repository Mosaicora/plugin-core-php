{
  "name": "mosaicora/plugin-core-php",
  "description": "Framework-agnostic Mosaicora Open Graph image URL and JSON-LD helpers for PHP.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://mosaicora.io/integrations/php",
  "support": {
    "issues": "https://github.com/Mosaicora/plugin-core-php/issues",
    "source": "https://github.com/Mosaicora/plugin-core-php"
  },
  "keywords": [
    "mosaicora",
    "open-graph",
    "og-image",
    "json-ld",
    "seo",
    "php"
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Mosaicora\\PluginCore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mosaicora\\PluginCore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "package:check": "composer archive --format=zip --dir=build"
  },
  "archive": {
    "exclude": [
      "/.github",
      "/.phpunit.cache",
      "/build",
      "/tests",
      "/composer.lock",
      "/phpunit.xml.dist",
      "/vendor"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
